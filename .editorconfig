# EditorConfig: https://editorconfig.org
# 改行・文字コードの正典は .gitattributes と揃える (LF 基本、Windows スクリプトのみ CRLF)。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[*.{ps1,psm1,cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
